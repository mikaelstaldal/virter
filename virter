)


def guest_localization(vendor_data: str, generate_locales: bool = False) -> str:
    environment = {key: os.environ[key] for key in LOCALE_VARIABLES if os.environ.get(key)}
    environment.setdefault("LANG", "C.UTF-8")
    timezone = read_timezone()
    if timezone:
        vendor_data += f"timezone: {yaml_encode(timezone)}\n"
    # TZ also accepts POSIX rules, which cloud-init's timezone setting cannot represent.
    if "TZ" in os.environ:
        environment["TZ"] = os.environ["TZ"]
    profile = "".join(f"export {key}={shlex.quote(value)}\n" for key, value in environment.items())
    file_data = "- path: /etc/profile.d/virter-locale.sh\n  content: " + yaml_encode(profile) + "\n"
    if re.search(r"^write_files:\n", vendor_data, re.MULTILINE):
        vendor_data = re.sub(r"^write_files:\n", lambda _: "write_files:\n" + file_data,
                             vendor_data, count=1, flags=re.MULTILINE)
    else:
        vendor_data += "write_files:\n" + file_data
    locales = sorted({value for key, value in environment.items()
                      if key not in ("LANGUAGE", "TZ") and value not in ("C", "POSIX", "C.UTF-8", "C.utf8")})
    if generate_locales and locales:
        command = "- " + yaml_encode(["locale-gen", *locales]) + "\n"
        # Generate locales before the getty can start a login shell.
        if re.search(r"^bootcmd:\n", vendor_data, re.MULTILINE):
            vendor_data = re.sub(r"^bootcmd:\n", lambda _: "bootcmd:\n" + command,
                                 vendor_data, count=1, flags=re.MULTILINE)
        else:
            vendor_data += "bootcmd:\n" + command
    return vendor_data


def read_timezone():
    override = os.environ.get("TZ", "").removeprefix(":")
    if override:
        zone = override.removeprefix("/usr/share/zoneinfo/")
        if not Path(zone).is_absolute() and ".." not in Path(zone).parts:
            if (Path("/usr/share/zoneinfo") / zone).is_file():
                return zone
    # /etc/localtime is a symlink like ../usr/share/zoneinfo/Europe/Stockholm
    try:
        target = os.readlink("/etc/localtime")
        _, sep, zone = target.partition("zoneinfo/")
        if sep and zone:
            return zone
    except OSError:
        pass
    try:
        return Path("/etc/timezone").read_text(encoding="utf-8").strip()
    except FileNotFoundError:
        return ""


def generate_cloud_init(name: str, temp_dir: Path, vendor_data: str, generate_locales: bool = False):
    # Reused base and instance names must still apply this invocation's cloud-config.
    (temp_dir / "meta-data").write_text(f"""#cloud-config
instance-id: {yaml_encode(f"{name}-{uuid.uuid4()}")}
local-hostname: {yaml_encode(name)}
cloud-name: virter
""", encoding="utf-8")
    (temp_dir / "network-config").write_text("""#cloud-config
{}
""", encoding="utf-8")
    (temp_dir / "vendor-data").write_text(guest_localization(vendor_data, generate_locales), encoding="utf-8")
    (temp_dir / "user-data").write_text("""#cloud-config
{}
""", encoding="utf-8")

    subprocess.run([
        "/usr/bin/genisoimage",
        "-quiet",
        "-output",
        "seed.img",
        "-volid",
        "cidata",
        "-rational-rock",
        "-joliet",
        "meta-data",
        "network-config",
        "vendor-data",
        "user-data",
    ], cwd=(str(temp_dir)), check=True)


def runtime_directory() -> Path:
    # Fixed across TMPDIR/XDG overrides so another invocation cannot export seed files.
    directory = Path(f"/run/user/{os.getuid()}")
    info = directory.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        sys.exit("A private systemd user runtime directory is required")
    return directory


def cache_directory() -> Path:
    configured = Path(os.environ.get("XDG_CACHE_HOME", ""))
    root = configured if configured.is_absolute() else Path.home() / ".cache"
    return root.absolute() / "virter"


def prepare_cache_dir() -> Path:
    cache_dir = cache_directory()
    cache_dir = cache_dir.absolute()
    # Check each component before creating children; never follow an attacker-prepared symlink.
    for directory in (*reversed(cache_dir.parents), cache_dir):
        try:
            directory.mkdir(mode=0o700)
        except FileExistsError:
            pass
        info = directory.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid not in (0, os.getuid()):
            sys.exit(f"Unsafe cache directory: {directory}")
        if info.st_mode & 0o022 and not (info.st_uid == 0 and info.st_mode & stat.S_ISVTX):
            sys.exit(f"Cache ancestor is writable by other users: {directory}")
    info = cache_dir.lstat()
    if info.st_uid != os.getuid() or info.st_mode & 0o077:
        sys.exit(f"Cache must be owned by the current user with private permissions (0700): {cache_dir}")
    return cache_dir


@contextmanager
def base_lock(cache_dir: Path, base: str, exclusive: bool):
    # Lock files persist: unlinking one would let waiters lock different inodes for the same base.
    fd = os.open(cache_dir / f"{base}.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
            sys.exit("Unsafe base lock file")
        fcntl.flock(fd, fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
        yield
    finally:
        os.close(fd)


def wait_for_socket(process: subprocess.Popen, socket_path: Path, timeout_seconds: float = 5):
    deadline = time.monotonic() + timeout_seconds
    while not socket_path.exists():
        if process.poll() is not None:
            sys.exit(f"virtiofsd exited with status {process.returncode}")
        if time.monotonic() > deadline:
            sys.exit(f"Timed out waiting for virtiofsd socket {socket_path}")
        time.sleep(0.01)


BRIDGE_SOCKET = "/run/virter-passt.sock"


def connect_bridge_backend() -> socket.socket:
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        connection.settimeout(5)
        connection.connect(BRIDGE_SOCKET)
        connection.settimeout(None)
    except OSError as error:
        connection.close()
        sys.exit(f"Bridge networking unavailable: {error}. See NETWORKING.md")
    return connection


def qemu_confinement(image: Path, temp_dir: Path, network: NetworkMode,
                     backing_image: Path | None) -> list[str]:
    command = [
        "/usr/bin/bwrap", "--unshare-all", "--unshare-user", "--disable-userns", "--assert-userns-disabled",
        "--die-with-parent",
        "--cap-drop", "ALL", "--clearenv",
        "--setenv", "PATH", "/usr/bin:/bin", "--setenv", "HOME", "/tmp",
        "--setenv", "LC_ALL", "C.UTF-8",
        "--ro-bind", "/usr", "/usr",
        "--symlink", "usr/bin", "/bin", "--symlink", "usr/sbin", "/sbin",
        "--symlink", "usr/lib", "/lib", "--ro-bind-try", "/lib64", "/lib64",
        "--proc", "/proc", "--dev", "/dev", "--dev-bind", "/dev/kvm", "/dev/kvm",
        "--tmpfs", "/dev/shm", "--tmpfs", "/tmp", "--chdir", "/tmp",
    ]
    if network == NetworkMode.HOST:
        command += ["--share-net", "--ro-bind-try", "/etc/resolv.conf", "/etc/resolv.conf"]
    if backing_image is not None:
        command += ["--ro-bind", str(backing_image), str(backing_image)]
    command += ["--bind", str(temp_dir), str(temp_dir)]
    if not image.is_relative_to(temp_dir):
        command += ["--bind", str(image), str(image)]
    return command + ["--"]


class ChildCleanupError(RuntimeError):
    pass


@contextmanager
def vm_children():
    children = []
    signals = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)

    starting = False
    pending_signal = None

    def interrupted(signum, frame):
        nonlocal pending_signal
        if starting:
            pending_signal = signum
        else:
            raise SystemExit(128 + signum)

    previous = {sig: signal.signal(sig, interrupted) for sig in signals}

    def start(command, **kwargs):
        nonlocal starting
        # Defer cancellation until the child is registered for cleanup.
        starting = True
        try:
            child = subprocess.Popen(command, **kwargs)
            children.append(child)
        finally:
            starting = False
            if pending_signal is not None:
                raise SystemExit(128 + pending_signal)
        return child

    try:
        yield start
    finally:
        # A second cancellation must not interrupt reaping or resource cleanup.
        for sig in signals:
            signal.signal(sig, signal.SIG_IGN)
        try:
            errors = []
            for child in reversed(children):
                try:
                    if child.poll() is None:
                        child.terminate()
                except OSError as error:
                    errors.append(error)
            for child in reversed(children):
                try:
                    try:
                        child.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        child.kill()
                        child.wait(timeout=5)
                except (OSError, subprocess.TimeoutExpired) as error:
                    errors.append(error)
            if errors:
                raise ChildCleanupError("Child cleanup failed; retaining VM files") from errors[0]
        finally:
            for sig, handler in previous.items():
                signal.signal(sig, handler)


def run_vm(name: str, vm_uuid: str, image: Path, temp_dir: Path, memory_mib: int, network: NetworkMode,
           is_prepare: bool, mounts: list[tuple[Path, bool]], ephemeral: bool,
           backing_image: Path | None = None):
    cloud_init_image = temp_dir / "seed.img"

    virtiofs_params = []
    with (vm_children() as start,
          connect_bridge_backend() if network == NetworkMode.BRIDGE else nullcontext() as backend):
        network_params = []
        match network:
            case NetworkMode.HOST:
                network_params = ["-nic", f"user,hostname={name},model=virtio-net-pci"]
            case NetworkMode.BRIDGE:
                network_params = [
                    "-netdev", f"stream,id=net0,addr.type=fd,addr.str={backend.fileno()}",
                    "-device", "virtio-net-pci,netdev=net0",
                ]
            case NetworkMode.NONE:
                network_params = ["-nic", "none"]

        for i, (mount_dir, mount_readonly) in enumerate(mounts):
            virtiofs_socket = temp_dir / f"vhostqemu{i}"
            virtiofsd = start(
                ["/usr/libexec/virtiofsd", "--log-level", "off", "--socket-path", virtiofs_socket, "--shared-dir",
                 mount_dir] + (["--readonly"] if mount_readonly else []),
                cwd=temp_dir, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            wait_for_socket(virtiofsd, virtiofs_socket)
            virtiofs_params += [
                "-chardev", f"socket,id=char{i},path={qemu_value(virtiofs_socket)}",
                "-device", f"vhost-user-fs-pci,queue-size=1024,chardev=char{i},tag=virtiofs{i}",
            ]

        command = (
            qemu_confinement(image, temp_dir, network, backing_image) + [
                "/usr/bin/qemu-system-x86_64",
                "-name", name,
                "-uuid", vm_uuid,
                "-cpu", "host",
                "-accel", "kvm",
                "-smp", str(VM_CPUS),
                "-m", f"{memory_mib}M",
                # Writes to an ephemeral image are discarded on exit, so there is no need to wait for flushes
                "-drive", f"file={qemu_value(image)},if=virtio,index=0,format=qcow2,media=disk,bps=268435456,iops=16384"
                          + (",cache=unsafe" if ephemeral else ""),
                "-drive", f"file={qemu_value(cloud_init_image)},index=1,media=cdrom,format=raw,readonly=on",
                "-sandbox", "on,obsolete=deny,elevateprivileges=deny,spawn=deny,resourcecontrol=deny",
                "-nographic",
                "-qmp", "null",
                "-chardev", "stdio,id=stdio,signal=off",
            ] + network_params +
            ([
                 "-serial", "chardev:stdio",
             ]
             if is_prepare else
             [
                 "-serial", "null",
                 "-serial", "chardev:stdio",
             ]) +
            virtiofs_params +
            ([
                 "-object",
                 f"memory-backend-file,id=mem,size={memory_mib}M,mem-path=/dev/shm,share=on",
                 "-numa", "node,memdev=mem",
             ] if mounts else [])
        )
        try:
            qemu = start(command, cwd=temp_dir, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                         pass_fds=(backend.fileno(),) if backend else ())
            if backend:
                # QEMU must hold the only client end: passt exits when that end closes.
                backend.close()
            try:
                relay_output(qemu.stdout)
            finally:
                qemu.stdout.close()
            returncode = qemu.wait()
            if returncode:
                raise subprocess.CalledProcessError(returncode, command)
        finally:
            # A guest can power off in an escape sequence, swallowing subsequent terminal output.
            if sys.stdout.isatty():
                sys.stdout.write("\x1b\\")
                sys.stdout.flush()


