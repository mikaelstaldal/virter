#!/usr/bin/env python3

import argparse
import getpass
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import uuid
from enum import StrEnum, auto
from pathlib import Path


CLOUD_CONFIG_HEADER = """#cloud-config
manage_etc_hosts: true
ssh_deletekeys: false
ssh_genkeytypes: []
"""

# Not needed in a short-lived VM, masked rather than purged since purging would also remove any requested
# packages depending on them
UNNEEDED_UNITS = [
    "apport.service",
    "apt-daily.timer",
    "apt-daily-upgrade.timer",
    "dpkg-db-backup.timer",
    "e2scrub_all.timer",
    "fstrim.timer",
    "fwupd-refresh.timer",
    "logrotate.timer",
    "man-db.timer",
    "ModemManager.service",
    "motd-news.timer",
    "multipathd.service",
    "multipathd.socket",
    "multipathd-queueing.service",
    "networkd-dispatcher.service",
    "rsyslog.service",
    "sysstat.service",
    "sysstat-collect.timer",
    "sysstat-rotate.timer",
    "sysstat-summary.timer",
    "udisks2.service",
    "unattended-upgrades.service",
    "update-notifier-download.timer",
    "update-notifier-motd.timer",
    "xfs_scrub_all.timer",
]


class NetworkMode(StrEnum):
    HOST = auto()
    NONE = auto()


def logical_name(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", value):
        raise argparse.ArgumentTypeError(
            "names must be 1-63 ASCII letters, digits or hyphens, starting and ending with a letter or digit")
    return value


def base_image_path(cache_dir: Path, base: str) -> Path:
    path = cache_dir / f"{base}.img"
    if path.is_symlink() or not path.resolve().is_relative_to(cache_dir.resolve()):
        sys.exit(f"Unsafe base image path: {path}")
    return path


def qemu_value(value: Path) -> str:
    # QemuOpts uses doubled commas for a literal comma inside a value.
    return str(value).replace(",", ",,")


def sha256_digest(value: str) -> str:
    if not re.fullmatch(r"[0-9a-fA-F]{64}", value):
        raise argparse.ArgumentTypeError("SHA-256 must contain exactly 64 hexadecimal digits")
    return value.lower()


def validate_import(image: Path, expected_sha256: str | None) -> None:
    with image.open("rb") as source:
        if expected_sha256 is None or hashlib.file_digest(source, "sha256").hexdigest() != expected_sha256:
            sys.exit("Image SHA-256 does not match the authenticated checksum")
        source.seek(0)
        header = source.read(104)
    version = int.from_bytes(header[4:8], "big")
    if len(header) < 72 or header[:4] != b"QFI\xfb" or version not in (2, 3):
        sys.exit("Only trusted standalone QCOW2 version 2 or 3 images are supported")
    if int.from_bytes(header[8:20], "big"):
        sys.exit("Images with backing files are not supported")
    if version == 3:
        if len(header) < 104 or int.from_bytes(header[100:104], "big") < 104:
            sys.exit("Invalid QCOW2 version 3 header")
        # Fail closed on external data, corrupt/dirty images and unknown incompatible features.
        if int.from_bytes(header[72:80], "big") & ~0x18:
            sys.exit("Unsupported QCOW2 incompatible features (including external data files)")


def main():
    parser = argparse.ArgumentParser()
    parser.set_defaults(func=None)
    subparsers = parser.add_subparsers()

    parser_prepare = subparsers.add_parser("prepare", help="Prepare base image")
    parser_prepare.add_argument("-i", "--image", type=Path, metavar="FILE", help="Image filename", required=True)
    parser_prepare.add_argument("--sha256", required=True, type=sha256_digest, metavar="HEX",
                                help="Image SHA-256 from an authenticated, trusted source")
    parser_prepare.add_argument("-b", "--base", type=logical_name, help="The base to prepare", default="base")
    parser_prepare.add_argument("-m", "--memory", type=int, metavar="MiB", help="Memory in MiB", default=1024)
    parser_prepare.add_argument("-d", "--disk", type=int, metavar="MiB", help="Disk in MiB", default=8192)
    parser_prepare.add_argument("-p", "--packages", nargs='+', metavar="PKG", help="Packages to install", default=[])
    parser_prepare.set_defaults(func=prepare)

    parser_update = subparsers.add_parser("update", help="Update base image")
    parser_update.add_argument("-b", "--base", type=logical_name, help="The base to update", default="base")
    parser_update.add_argument("-m", "--memory", type=int, metavar="MiB", help="Memory in MiB", default=1024)
    parser_update.set_defaults(func=update)

    parser_run = subparsers.add_parser("run", help="Run an instance")
    parser_run.add_argument("-n", "--name", type=logical_name, help="Name of the instance", default=f"instance-{int(time.time())}")
    parser_run.add_argument("-b", "--base", type=logical_name, help="The base to use", default="base")
    parser_run.add_argument("-m", "--memory", type=int, metavar="MiB", help="Memory in MiB", default=1024)
    parser_run.add_argument("--network", choices=["host", "none"], default="host", help="Network mode")
    parser_run.add_argument("-w", "--workdir", metavar="DIR", help="Change to this directory inside the VM")
    parser_run.add_argument("--mount", type=Path, metavar="DIR", action="append", default=[],
                            help="Mount a directory in VM read-only, can be repeated")
    parser_run.add_argument("--mount-writable", type=Path, metavar="DIR", action="append", default=[],
                            help="Mount a directory in VM writable, can be repeated")
    current_dir_mounts = parser_run.add_mutually_exclusive_group()
    current_dir_mounts.add_argument("--current-dir", action='store_true',
                                    help="Mount the current directory in VM read-only")
    current_dir_mounts.add_argument("--current-dir-writable", action='store_true',
                                    help="Mount the current directory in VM writable")
    parser_run.add_argument("COMMAND", nargs="?", help="Command to run")
    parser_run.add_argument("ARG", nargs="*", help="Arguments to command")
    parser_run.set_defaults(func=run)

    args = parser.parse_args()
    if args.func:
        if os.getuid() == 0 or os.geteuid() == 0:
            parser.error("virter must run as an unprivileged user; do not use sudo")
        if shutil.which("bwrap") is None:
            parser.error("Bubblewrap (bwrap) is required for QEMU confinement")
        try:
            with tempfile.TemporaryDirectory() as directory:
                temporary = Path(directory)
                subprocess.run(qemu_confinement(temporary / "disk.img", temporary, NetworkMode.NONE, None)
                               + ["/usr/bin/true"], check=True, stdout=subprocess.DEVNULL,
                               stderr=subprocess.PIPE, text=True)
        except (OSError, subprocess.CalledProcessError) as error:
            detail = error.stderr if isinstance(error, subprocess.CalledProcessError) else str(error)
            parser.error(f"QEMU confinement preflight failed: {detail}")
        args.func(args)
    else:
        parser.print_help()


def prepare(args):
    base_image = args.image
    if not base_image.is_file():
        sys.exit("Base image not found")
    base = args.base
    memory_mib = args.memory
    disk_mib = args.disk
    packages = args.packages
    prepare_or_update(base_image, base, memory_mib, disk_mib, packages, args.sha256)


def update(args):
    base = args.base
    memory_mib = args.memory
    prepare_or_update(None, base, memory_mib, None, [])


def prepare_or_update(base_image: Path | None, base: str, memory_mib: int, disk_mib: int | None,
                      packages: list[str], expected_sha256: str | None = None) -> None:
    name = base
    vm_uuid = str(uuid.uuid4())

    cache_dir = prepare_cache_dir()
    base_path = base_image_path(cache_dir, base)

    if base_image:
        try:
            with base_image.open("rb") as source, base_path.open("xb") as destination:
                try:
                    shutil.copyfileobj(source, destination)
                    destination.flush()
                    validate_import(base_path, expected_sha256)
                except BaseException:
                    base_path.unlink()
                    raise
        except FileExistsError:
            sys.exit(f"Base {base} already exists, choose another base name")
        subprocess.run([
            "qemu-img",
            "resize",
            "-f", "qcow2",
            "-q",
            str(base_path),
            f"{disk_mib}M"
        ], check=True)
    else:
        if not base_path.is_file():
            sys.exit(f"Base {base} not found")

    temp_dir = Path(tempfile.mkdtemp())
    try:
        if base_image:
            cloud_init_prepare(name, temp_dir, packages)
        else:
            cloud_init_update(name, temp_dir)

        run_vm(name, vm_uuid, base_path, temp_dir, memory_mib, NetworkMode.HOST,
               base_image is not None, mounts=[], ephemeral=False)
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)


def collect_mounts(args) -> list[tuple[Path, bool]]:
    requested = [(path, True) for path in args.mount] + [(path, False) for path in args.mount_writable]
    if args.current_dir or args.current_dir_writable:
        requested.append((Path("."), args.current_dir))

    mounts = {}
    for path, readonly in requested:
        mount_dir = path.resolve()
        if not mount_dir.is_dir():
            sys.exit(f"Directory {mount_dir} not found")
        if mount_dir in mounts:
            sys.exit(f"Directory {mount_dir} specified more than once")
        mounts[mount_dir] = readonly

    # A parent must be mounted before its subdirectories, otherwise it would hide them
    return sorted(mounts.items(), key=lambda mount: len(mount[0].parts))


def run(args):
    name = args.name
    base = args.base
    memory_mib = args.memory
    network = NetworkMode(args.network)
    mounts = collect_mounts(args)

    vm_uuid = str(uuid.uuid4())

    cache_dir = prepare_cache_dir()
    base_path = base_image_path(cache_dir, base)

    if not base_path.is_file():
        sys.exit(f"Base {base} not found")

    temp_dir = Path(tempfile.mkdtemp(dir=cache_dir))
    img_path = temp_dir / "disk.img"
    try:
        subprocess.run([
            "qemu-img",
            "create",
            "-q",
            "-f",
            "qcow2",
            "-b",
            str(base_path),
            "-F",
            "qcow2",
            str(img_path),
        ], check=True)

        mount_data = "bootcmd:\n" + "".join(f"""- mkdir -p "{mount_dir}"
- mount -t virtiofs {"-o ro" if mount_readonly else ""} virtiofs{i} "{mount_dir}"
""" for i, (mount_dir, mount_readonly) in enumerate(mounts)) if mounts else ""

        username = getpass.getuser()
        cols, rows = shutil.get_terminal_size()
        profile_lines = [f"stty cols {cols} rows {rows}"]
        if args.workdir:
            profile_lines.append(f"cd {shlex.quote(args.workdir)}")
        if args.COMMAND:
            profile_lines.append(shlex.join([args.COMMAND, *args.ARG]))
            # The image is discarded, so skip the slow orderly shutdown. Drain the serial output first, a
            # forced poweroff would otherwise cut it off. If the poweroff fails, logout shuts down normally.
            profile_lines.append('sync; stty "$(stty -g)"; sudo poweroff -ff >/dev/null 2>&1')
            profile_lines.append("logout")
        hushlogin_data = f"""- path: \"/home/{username}/.hushlogin\"
""" if args.workdir or args.COMMAND else ""
        command_data = f"""write_files:
{hushlogin_data}- path: \"/home/{username}/.profile\"
  append: true
  content: |
""" + "".join(f"    {line}\n" for line in profile_lines)

        generate_cloud_init(
            name,
            temp_dir,
            vendor_data=CLOUD_CONFIG_HEADER + "users: []\n" + mount_data + command_data)

        run_vm(name, vm_uuid, img_path, temp_dir, memory_mib, network, is_prepare=False,
               mounts=mounts, ephemeral=True, backing_image=base_path)
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)


def cloud_init_prepare(name: str, temp_dir: Path, packages: list[str]):
    username = getpass.getuser()
    cols, rows = shutil.get_terminal_size()
    timezone = read_timezone()
    timezone_data = f"timezone: {timezone}\n" if timezone else ""
    generate_cloud_init(
        name,
        temp_dir,
        f"""{CLOUD_CONFIG_HEADER}{timezone_data}user:
  name: \"{username}\"
  uid: \"{os.getuid()}\"
  groups: [adm, cdrom, dip, lxd, sudo]
  sudo: [\"ALL=(ALL) NOPASSWD:ALL\"]
  shell: /bin/bash
package_update: true
package_upgrade: true
packages: {json.dumps(packages)}
write_files:
- path: /etc/systemd/system/serial-getty@.service.d/override.conf
  content: |
    [Service]
    ExecStart=
    ExecStart=-/usr/bin/login -p -f -- {username}
    ExecStart=/sbin/shutdown -h --no-wall now
    Type=oneshot
    Restart=no
    TTYColumns={cols}
    TTYRows={rows}
- path: /etc/default/grub.d/50-cloudimg-settings.cfg
  content: |
    GRUB_RECORDFAIL_TIMEOUT=0
    GRUB_TIMEOUT=0
    GRUB_CMDLINE_LINUX_DEFAULT="quiet console=ttyS0 systemd.getty_auto=no"
    GRUB_TERMINAL=console      
runcmd:
 - DEBIAN_FRONTEND=noninteractive apt-get purge -y openssh-server
 - systemctl mask {" ".join(UNNEEDED_UNITS)}
 - systemctl disable getty@tty1.service
 - systemctl disable serial-getty@ttyS0.service
 - systemctl enable serial-getty@ttyS1.service
 - update-grub 
power_state:
  delay: now
  mode: poweroff
  timeout: 10
  condition: true
"""
    )


def cloud_init_update(name, temp_dir: Path):
    generate_cloud_init(
        name,
        temp_dir,
        CLOUD_CONFIG_HEADER + "users: []\n"
    )


def read_timezone():
    # /etc/localtime is a symlink like ../usr/share/zoneinfo/Europe/Stockholm
    try:
        target = os.readlink("/etc/localtime")
        _, sep, zone = target.partition("zoneinfo/")
        if sep and zone:
            return zone
    except OSError:
        pass
    try:
        return Path("/etc/timezone").read_text(encoding="utf-8").strip()
    except FileNotFoundError:
        return ""


def generate_cloud_init(name: str, temp_dir: Path, vendor_data: str):
    (temp_dir / "meta-data").write_text(f"""#cloud-config
instance-id: {name}
local-hostname: {name}
cloud-name: virter
""", encoding="utf-8")
    (temp_dir / "network-config").write_text("""#cloud-config
{}
""", encoding="utf-8")
    (temp_dir / "vendor-data").write_text(vendor_data, encoding="utf-8")
    (temp_dir / "user-data").write_text("""#cloud-config
{}
""", encoding="utf-8")

    subprocess.run([
        "genisoimage",
        "-quiet",
        "-output",
        "seed.img",
        "-volid",
        "cidata",
        "-rational-rock",
        "-joliet",
        "meta-data",
        "network-config",
        "vendor-data",
        "user-data",
    ], cwd=(str(temp_dir)), check=True)


def prepare_cache_dir() -> Path:
    cache_home = os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))
    cache_dir = Path(cache_home) / "virter"
    cache_dir.mkdir(parents=True, exist_ok=True)
    return cache_dir.resolve()


def wait_for_socket(process: subprocess.Popen, socket_path: Path, timeout_seconds: float = 5):
    deadline = time.monotonic() + timeout_seconds
    while not socket_path.exists():
        if process.poll() is not None:
            sys.exit(f"virtiofsd exited with status {process.returncode}")
        if time.monotonic() > deadline:
            sys.exit(f"Timed out waiting for virtiofsd socket {socket_path}")
        time.sleep(0.01)


def qemu_confinement(image: Path, temp_dir: Path, network: NetworkMode,
                     backing_image: Path | None) -> list[str]:
    command = [
        "bwrap", "--unshare-all", "--unshare-user", "--disable-userns", "--assert-userns-disabled",
        "--die-with-parent",
        "--cap-drop", "ALL", "--clearenv",
        "--setenv", "PATH", "/usr/bin:/bin", "--setenv", "HOME", "/tmp",
        "--setenv", "LC_ALL", "C.UTF-8",
        "--ro-bind", "/usr", "/usr",
        "--symlink", "usr/bin", "/bin", "--symlink", "usr/sbin", "/sbin",
        "--symlink", "usr/lib", "/lib", "--ro-bind-try", "/lib64", "/lib64",
        "--proc", "/proc", "--dev", "/dev", "--dev-bind", "/dev/kvm", "/dev/kvm",
        "--tmpfs", "/dev/shm", "--tmpfs", "/tmp", "--chdir", "/tmp",
    ]
    if network == NetworkMode.HOST:
        command += ["--share-net", "--ro-bind-try", "/etc/resolv.conf", "/etc/resolv.conf"]
    if backing_image is not None:
        command += ["--ro-bind", str(backing_image), str(backing_image)]
    command += ["--bind", str(temp_dir), str(temp_dir)]
    if not image.is_relative_to(temp_dir):
        command += ["--bind", str(image), str(image)]
    return command + ["--"]


def run_vm(name: str, vm_uuid: str, image: Path, temp_dir: Path, memory_mib: int, network: NetworkMode,
           is_prepare: bool, mounts: list[tuple[Path, bool]], ephemeral: bool,
           backing_image: Path | None = None):
    cloud_init_image = temp_dir / "seed.img"

    network_params = []
    match network:
        case NetworkMode.HOST:
            network_params = ["-nic", f"user,hostname={name},model=virtio-net-pci"]
        case NetworkMode.NONE:
            network_params = ["-nic", "none"]

    virtiofsds = []
    virtiofs_params = []
    try:
        for i, (mount_dir, mount_readonly) in enumerate(mounts):
            virtiofs_socket = temp_dir / f"vhostqemu{i}"
            virtiofsd = subprocess.Popen(
                ["/usr/libexec/virtiofsd", "--log-level", "off", "--socket-path", virtiofs_socket, "--shared-dir",
                 mount_dir] + (["--readonly"] if mount_readonly else []))
            virtiofsds.append(virtiofsd)
            wait_for_socket(virtiofsd, virtiofs_socket)
            virtiofs_params += [
                "-chardev", f"socket,id=char{i},path={qemu_value(virtiofs_socket)}",
                "-device", f"vhost-user-fs-pci,queue-size=1024,chardev=char{i},tag=virtiofs{i}",
            ]

        subprocess.run(
            qemu_confinement(image, temp_dir, network, backing_image) + [
                "/usr/bin/qemu-system-x86_64",
                "-name", name,
                "-uuid", vm_uuid,
                "-cpu", "host",
                "-accel", "kvm",
                "-smp", "4",
                "-m", f"{memory_mib}M",
                # Writes to an ephemeral image are discarded on exit, so there is no need to wait for flushes
                "-drive", f"file={qemu_value(image)},if=virtio,index=0,format=qcow2,media=disk"
                          + (",cache=unsafe" if ephemeral else ""),
                "-drive", f"file={qemu_value(cloud_init_image)},index=1,media=cdrom",
                "-sandbox", "on,obsolete=deny,elevateprivileges=deny,spawn=deny,resourcecontrol=deny",
                "-nographic",
                "-qmp", "null",
                "-chardev", "stdio,id=stdio,signal=off",
            ] + network_params +
            ([
                 "-serial", "chardev:stdio",
             ]
             if is_prepare else
             [
                 "-serial", "null",
                 "-serial", "chardev:stdio",
             ]) +
            virtiofs_params +
            ([
                 "-object",
                 f"memory-backend-file,id=mem,size={memory_mib}M,mem-path=/dev/shm,share=on",
                 "-numa", "node,memdev=mem",
             ] if mounts else []),
            check=True
        )
    finally:
        for virtiofsd in virtiofsds:
            virtiofsd.terminate()
            virtiofsd.wait()
        # The guest can power off in the middle of an escape sequence, then the terminal would swallow what follows
        if sys.stdout.isatty():
            sys.stdout.write("\x1b\\")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
