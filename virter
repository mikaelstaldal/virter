#!/usr/bin/env python3

import argparse
import getpass
import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import uuid
from enum import StrEnum, auto
from pathlib import Path


CLOUD_CONFIG_HEADER = """#cloud-config
manage_etc_hosts: true
"""


class NetworkMode(StrEnum):
    HOST = auto()
    NONE = auto()


def main():
    parser = argparse.ArgumentParser()
    parser.set_defaults(func=None)
    subparsers = parser.add_subparsers()

    parser_prepare = subparsers.add_parser("prepare", help="Prepare base image")
    parser_prepare.add_argument("-i", "--image", type=Path, metavar="FILE", help="Image filename", required=True)
    parser_prepare.add_argument("-b", "--base", help="The base to prepare", default="base")
    parser_prepare.add_argument("-m", "--memory", type=int, metavar="MiB", help="Memory in MiB", default=1024)
    parser_prepare.add_argument("-d", "--disk", type=int, metavar="MiB", help="Disk in MiB", default=8192)
    parser_prepare.add_argument("-p", "--packages", nargs='+', metavar="PKG", help="Packages to install", default=[])
    parser_prepare.set_defaults(func=prepare)

    parser_update = subparsers.add_parser("update", help="Update base image")
    parser_update.add_argument("-b", "--base", help="The base to update", default="base")
    parser_update.add_argument("-m", "--memory", type=int, metavar="MiB", help="Memory in MiB", default=1024)
    parser_update.set_defaults(func=update)

    parser_run = subparsers.add_parser("run", help="Run an instance")
    parser_run.add_argument("-n", "--name", help="Name of the instance", default=f"instance-{int(time.time())}")
    parser_run.add_argument("-b", "--base", help="The base to use", default="base")
    parser_run.add_argument("-m", "--memory", type=int, metavar="MiB", help="Memory in MiB", default=1024)
    parser_run.add_argument("--network", choices=["host", "none"], default="host", help="Network mode")
    parser_run.add_argument("-w", "--workdir", metavar="DIR", help="Change to this directory inside the VM")
    mounts = parser_run.add_mutually_exclusive_group()
    mounts.add_argument("--mount", type=Path, metavar="DIR", help="Mount a directory in VM read-only")
    mounts.add_argument("--mount-writable", type=Path, metavar="DIR", help="Mount a directory in VM writable")
    mounts.add_argument("--current-dir", action='store_true', help="Mount the current directory in VM read-only")
    mounts.add_argument("--current-dir-writable", action='store_true',
                        help="Mount the current directory in VM writable")
    parser_run.add_argument("COMMAND", nargs="?", help="Command to run")
    parser_run.add_argument("ARG", nargs="*", help="Arguments to command")
    parser_run.set_defaults(func=run)

    args = parser.parse_args()
    if args.func:
        args.func(args)
    else:
        parser.print_help()


def prepare(args):
    base_image = args.image
    if not base_image.is_file():
        sys.exit("Base image not found")
    base = args.base
    memory_mib = args.memory
    disk_mib = args.disk
    packages = args.packages
    prepare_or_update(base_image, base, memory_mib, disk_mib, packages)


def update(args):
    base = args.base
    memory_mib = args.memory
    prepare_or_update(None, base, memory_mib, None, [])


def prepare_or_update(base_image: Path | None, base: str, memory_mib: int, disk_mib: int | None,
                      packages: list[str]) -> None:
    name = base
    vm_uuid = str(uuid.uuid4())

    cache_dir = prepare_cache_dir()
    base_path = cache_dir / f"{base}.img"

    if base_image:
        shutil.copy(base_image, base_path)
        subprocess.run([
            "qemu-img",
            "resize",
            "-q",
            str(base_path),
            f"{disk_mib}M"
        ], check=True)
    else:
        if not base_path.is_file():
            sys.exit(f"Base {base} not found")

    temp_dir = Path(tempfile.mkdtemp())
    try:
        if base_image:
            cloud_init_prepare(name, temp_dir, packages)
        else:
            cloud_init_update(name, temp_dir)

        run_vm(name, vm_uuid, base_path, temp_dir, memory_mib, NetworkMode.HOST,
               base_image is not None, None, False)
    finally:
        pid_path = cache_dir / f"{name}.pid"
        if pid_path.exists():
            pid_path.unlink()
        shutil.rmtree(temp_dir, ignore_errors=True)


def run(args):
    name = args.name
    base = args.base
    memory_mib = args.memory
    network = NetworkMode(args.network)
    mount_dir = args.mount_writable if args.mount_writable is not None \
        else args.mount if args.mount is not None \
        else Path(".") if args.current_dir or args.current_dir_writable else None
    if mount_dir is not None:
        mount_dir = mount_dir.resolve()
        if not mount_dir.is_dir():
            sys.exit(f"Directory {mount_dir} not found")
    mount_readonly = args.mount is not None or args.current_dir

    vm_uuid = str(uuid.uuid4())

    cache_dir = prepare_cache_dir()
    base_path = cache_dir / f"{base}.img"

    if not base_path.is_file():
        sys.exit(f"Base {base} not found")

    # The instance image is deleted on exit, so it must not reuse the name of an existing image
    img_path = cache_dir / f"{name}.img"
    if img_path.exists():
        sys.exit(f"Image {img_path} already exists, choose another name")

    temp_dir = Path(tempfile.mkdtemp())
    try:
        subprocess.run([
            "qemu-img",
            "create",
            "-q",
            "-f",
            "qcow2",
            "-b",
            str(base_path),
            "-F",
            "qcow2",
            str(img_path),
        ], check=True)

        mount_data = f"""bootcmd:
- mkdir -p "{mount_dir}"         
- mount -t virtiofs {"-o ro" if mount_readonly else ""} virtiofs "{mount_dir}"
""" if mount_dir else ""

        username = getpass.getuser()
        cols, rows = shutil.get_terminal_size()
        profile_lines = [f"stty cols {cols} rows {rows}"]
        if args.workdir:
            profile_lines.append(f"cd {shlex.quote(args.workdir)}")
        if args.COMMAND:
            profile_lines.append(shlex.join([args.COMMAND, *args.ARG]))
            profile_lines.append("logout")
        hushlogin_data = f"""- path: \"/home/{username}/.hushlogin\"
""" if args.workdir or args.COMMAND else ""
        command_data = f"""write_files:
{hushlogin_data}- path: \"/home/{username}/.profile\"
  append: true
  content: |
""" + "".join(f"    {line}\n" for line in profile_lines)

        generate_cloud_init(
            name,
            temp_dir,
            vendor_data=CLOUD_CONFIG_HEADER + "users: []\n" + mount_data + command_data)

        run_vm(name, vm_uuid, img_path, temp_dir, memory_mib, network, is_prepare=False,
               mount_dir=mount_dir, mount_readonly=mount_readonly)
    finally:
        if img_path.exists():
            img_path.unlink()
        pid_path = cache_dir / f"{name}.pid"
        if pid_path.exists():
            pid_path.unlink()
        shutil.rmtree(temp_dir, ignore_errors=True)


def cloud_init_prepare(name: str, temp_dir: Path, packages: list[str]):
    username = getpass.getuser()
    cols, rows = shutil.get_terminal_size()
    timezone = read_timezone()
    timezone_data = f"timezone: {timezone}\n" if timezone else ""
    generate_cloud_init(
        name,
        temp_dir,
        f"""{CLOUD_CONFIG_HEADER}{timezone_data}user:
  name: \"{username}\"
  uid: \"{os.getuid()}\"
  groups: [adm, cdrom, dip, lxd, sudo]
  sudo: [\"ALL=(ALL) NOPASSWD:ALL\"]
  shell: /bin/bash
package_update: true
package_upgrade: true
packages: {json.dumps(packages)}
write_files:
- path: /etc/systemd/system/serial-getty@.service.d/override.conf
  content: |
    [Service]
    ExecStart=
    ExecStart=-/usr/bin/login -p -f -- {username}
    ExecStart=/sbin/shutdown -h --no-wall now
    Type=oneshot
    Restart=no
    TTYColumns={cols}
    TTYRows={rows}
- path: /etc/default/grub.d/50-cloudimg-settings.cfg
  content: |
    GRUB_RECORDFAIL_TIMEOUT=0
    GRUB_TIMEOUT=0
    GRUB_CMDLINE_LINUX_DEFAULT="quiet console=ttyS0 systemd.getty_auto=no"
    GRUB_TERMINAL=console      
runcmd:
 - systemctl disable ssh
 - systemctl disable ssh.socket
 - systemctl disable getty@tty1.service
 - systemctl disable serial-getty@ttyS0.service
 - systemctl enable serial-getty@ttyS1.service
 - update-grub 
power_state:
  delay: now
  mode: poweroff
  timeout: 10
  condition: true
"""
    )


def cloud_init_update(name, temp_dir: Path):
    generate_cloud_init(
        name,
        temp_dir,
        CLOUD_CONFIG_HEADER + "users: []\n"
    )


def read_timezone():
    # /etc/localtime is a symlink like ../usr/share/zoneinfo/Europe/Stockholm
    try:
        target = os.readlink("/etc/localtime")
        _, sep, zone = target.partition("zoneinfo/")
        if sep and zone:
            return zone
    except OSError:
        pass
    try:
        return Path("/etc/timezone").read_text(encoding="utf-8").strip()
    except FileNotFoundError:
        return ""


def generate_cloud_init(name: str, temp_dir: Path, vendor_data: str):
    (temp_dir / "meta-data").write_text(f"""#cloud-config
instance-id: {name}
local-hostname: {name}
cloud-name: virter
""", encoding="utf-8")
    (temp_dir / "network-config").write_text("""#cloud-config
{}
""", encoding="utf-8")
    (temp_dir / "vendor-data").write_text(vendor_data, encoding="utf-8")
    (temp_dir / "user-data").write_text("""#cloud-config
{}
""", encoding="utf-8")

    subprocess.run([
        "genisoimage",
        "-quiet",
        "-output",
        f"{name}-seed.img",
        "-volid",
        "cidata",
        "-rational-rock",
        "-joliet",
        "meta-data",
        "network-config",
        "vendor-data",
        "user-data",
    ], cwd=(str(temp_dir)), check=True)


def prepare_cache_dir() -> Path:
    cache_home = os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))
    cache_dir = Path(cache_home) / "virter"
    cache_dir.mkdir(parents=True, exist_ok=True)
    return cache_dir


def run_vm(name: str, vm_uuid: str, image: Path, temp_dir: Path, memory_mib: int, network: NetworkMode,
           is_prepare: bool, mount_dir: Path | None, mount_readonly: bool):
    cache_dir = prepare_cache_dir()
    cloud_init_image = temp_dir / f"{name}-seed.img"
    virtiofs_socket = temp_dir / "vhostqemu"
    virtiofsd = None
    if mount_dir is not None:
        virtiofsd = subprocess.Popen(
            ["/usr/libexec/virtiofsd", "--log-level", "off", "--socket-path", virtiofs_socket, "--shared-dir",
             mount_dir] + (["--readonly"] if mount_readonly else []))

    network_params = []
    match network:
        case NetworkMode.HOST:
            network_params = ["-nic", f"user,hostname={name}"]
        case NetworkMode.NONE:
            network_params = ["-nic", "none"]

    try:
        subprocess.run(
            [
                "qemu-system-x86_64",
                "-name", name,
                "-uuid", vm_uuid,
                "-pidfile", str(cache_dir / f"{name}.pid"),
                "-cpu", "host",
                "-accel", "kvm",
                "-m", f"{memory_mib}M",
                "-drive", f"file={image},index=0,format=qcow2,media=disk",
                "-drive", f"file={cloud_init_image},index=1,media=cdrom",
                "-sandbox", "on",
                "-nographic",
                "-qmp", "null",
                "-chardev", "stdio,id=stdio,signal=off",
            ] + network_params +
            ([
                 "-serial", "chardev:stdio",
             ]
             if is_prepare else
             [
                 "-serial", "null",
                 "-serial", "chardev:stdio",
             ]) +
            ([
                 "-chardev", f"socket,id=char0,path={virtiofs_socket}",
                 "-device", "vhost-user-fs-pci,queue-size=1024,chardev=char0,tag=virtiofs",
                 "-object",
                 f"memory-backend-file,id=mem,size={memory_mib}M,mem-path=/dev/shm,share=on",
                 "-numa", "node,memdev=mem",
             ] if mount_dir is not None else []),
            check=True
        )
    finally:
        if virtiofsd is not None:
            virtiofsd.terminate()
            virtiofsd.wait()


if __name__ == "__main__":
    main()
