class NetworkMode(StrEnum):
    HOST = auto()
    BRIDGE = auto()
    NONE = auto()


def logical_name(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", value):
        raise argparse.ArgumentTypeError(
            "names must be 1-63 ASCII letters, digits or hyphens, starting and ending with a letter or digit")
    return value


def base_image_path(cache_dir: Path, base: str) -> Path:
    path = cache_dir / f"{base}.img"
    if path.is_symlink() or not path.resolve().is_relative_to(cache_dir.resolve()):
        sys.exit(f"Unsafe base image path: {path}")
    if path.exists():
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
            sys.exit(f"Unsafe base image file: {path}")
    return path


def qemu_value(value: Path) -> str:
    # QemuOpts uses doubled commas for a literal comma inside a value.
    return str(value).replace(",", ",,")


def sha256_digest(value: str) -> str:
    if not re.fullmatch(r"[0-9a-fA-F]{64}", value):
        raise argparse.ArgumentTypeError("SHA-256 must contain exactly 64 hexadecimal digits")
    return value.lower()


def validate_import(image: Path, expected_sha256: str | None) -> None:
    with image.open("rb") as source:
        if expected_sha256 is None or hashlib.file_digest(source, "sha256").hexdigest() != expected_sha256:
            sys.exit("Image SHA-256 does not match the authenticated checksum")
        source.seek(0)
        header = source.read(104)
    version = int.from_bytes(header[4:8], "big")
    if len(header) < 72 or header[:4] != b"QFI\xfb" or version not in (2, 3):
        sys.exit("Only trusted standalone QCOW2 version 2 or 3 images are supported")
    if int.from_bytes(header[8:20], "big"):
        sys.exit("Images with backing files are not supported")
    if version == 3:
        if len(header) < 104 or int.from_bytes(header[100:104], "big") < 104:
            sys.exit("Invalid QCOW2 version 3 header")
        # Fail closed on external data, corrupt/dirty images and unknown incompatible features.
        if int.from_bytes(header[72:80], "big") & ~0x18:
            sys.exit("Unsupported QCOW2 incompatible features (including external data files)")


# Limits apply to the launcher and every descendant, including virtiofsd.
VM_CPUS = 4
MAX_FILE_BYTES = 20 * 1024 ** 3
MAX_OUTPUT_BYTES = 16 * 1024 ** 2


def validate_disk_size(image: Path):
    if image.stat().st_size > MAX_FILE_BYTES:
        sys.exit("Image exceeds the 20 GiB host file-size limit")
    with image.open("rb") as source:
        header = source.read(32)
    if header[:4] == b"QFI\xfb" and int.from_bytes(header[24:32], "big") > 16384 * 1024 ** 2:
        sys.exit("Image exceeds the 16384 MiB virtual disk limit; use a smaller trusted base")


def bounded_integer(minimum: int, maximum: int):
    def parse(value):
        try:
            number = int(value)
        except ValueError:
            raise argparse.ArgumentTypeError("expected an integer") from None
        if not minimum <= number <= maximum:
            raise argparse.ArgumentTypeError(f"must be between {minimum} and {maximum}")
        return number
    return parse


def supervise(args):
    unit = f"virter-{uuid.uuid4()}.scope"
    command = [
        "/usr/bin/systemd-run", "--user", "--scope", "--quiet", "--collect", "--expand-environment=no",
        f"--unit={unit}", f"--property=CPUQuota={VM_CPUS * 100}%", f"--property=MemoryMax={args.memory + 1024}M",
        "--property=MemorySwapMax=0", "--property=TasksMax=128",
        f"--property=RuntimeMaxSec={args.timeout}", "--property=TimeoutStopSec=15s",
        "--property=KillMode=control-group", "--property=OOMPolicy=kill", "--",
        sys.executable, str(Path(__file__).resolve()), f"--_supervised={unit}", *sys.argv[1:],
    ]
    # exec preserves the terminal and exit status; scope startup failure has no fallback.
    os.execv(command[0], command)


@contextmanager
def resource_limits(args):
    membership = Path("/proc/self/cgroup").read_text().strip()
    if not membership.startswith("0::/") or Path(membership[3:]).name != args._supervised:
        sys.exit("Resource supervision requires the assigned cgroup v2 scope")
    group = Path("/sys/fs/cgroup") / membership[4:]
    try:
        memory = int((group / "memory.max").read_text())
        swap = int((group / "memory.swap.max").read_text())
        tasks = int((group / "pids.max").read_text())
        quota, period = map(int, (group / "cpu.max").read_text().split())
        if memory > (args.memory + 1024) * 1024 ** 2 or swap != 0 or tasks > 128 or quota > VM_CPUS * period:
            raise ValueError("limits exceed policy")
    except (OSError, ValueError) as error:
        sys.exit(f"Required cgroup resource limits are unavailable: {error}")

    # A fixed per-user runtime directory prevents changing XDG_CACHE_HOME from bypassing the limit.
    directory = runtime_directory()
    locks = []
    try:
        for slot in range(2):
            fd = os.open(directory / f"virter-{slot}.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                os.close(fd)
                continue
            locks.append(fd)
            break
        else:
            sys.exit("At most two virter invocations may run concurrently per user")
        resource.setrlimit(resource.RLIMIT_FSIZE, (MAX_FILE_BYTES, MAX_FILE_BYTES))
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        yield
    finally:
        for fd in locks:
            os.close(fd)


def relay_output(stream):
    sys.stdout.flush()
    remaining = MAX_OUTPUT_BYTES
    while chunk := stream.read1(min(65536, remaining + 1)):
        if len(chunk) > remaining:
            sys.exit("VM output limit exceeded (16 MiB)")
        sys.stdout.buffer.write(chunk)
        sys.stdout.buffer.flush()
        remaining -= len(chunk)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--_supervised", help=argparse.SUPPRESS)
    parser.set_defaults(func=None)
    subparsers = parser.add_subparsers()

    parser_prepare = subparsers.add_parser("prepare", help="Prepare base image")
    parser_prepare.add_argument("-i", "--image", type=Path, metavar="FILE", help="Image filename", required=True)
    parser_prepare.add_argument("--sha256", required=True, type=sha256_digest, metavar="HEX",
                                help="Image SHA-256 from an authenticated, trusted source")
    parser_prepare.add_argument("-b", "--base", type=logical_name, help="The base to prepare", default="base")
    parser_prepare.add_argument("-m", "--memory", type=bounded_integer(128, 8192), metavar="MiB", help="Memory in MiB (128-8192)", default=1024)
    parser_prepare.add_argument("-d", "--disk", type=bounded_integer(1024, 16384), metavar="MiB", help="Disk in MiB (1024-16384)", default=8192)
    parser_prepare.add_argument("-p", "--packages", nargs='+', metavar="PKG", help="Packages to install", default=[])
    parser_prepare.set_defaults(func=prepare)

    parser_update = subparsers.add_parser("update", help="Update base image")
    parser_update.add_argument("-b", "--base", type=logical_name, help="The base to update", default="base")
    parser_update.add_argument("-m", "--memory", type=bounded_integer(128, 8192), metavar="MiB", help="Memory in MiB (128-8192)", default=1024)
    parser_update.add_argument("--sudo", action="store_true", help="Run the update command as root")
    parser_update.add_argument("COMMAND", nargs=argparse.REMAINDER,
                            help="Command and arguments; virter options must precede the command")
    parser_update.set_defaults(func=update)

    parser_run = subparsers.add_parser("run", help="Run an instance")
    parser_run.add_argument("-n", "--name", type=logical_name, help="Name of the instance", default=f"instance-{int(time.time())}")
    parser_run.add_argument("-b", "--base", type=logical_name, help="The base to use", default="base")
    parser_run.add_argument("-m", "--memory", type=bounded_integer(128, 8192), metavar="MiB", help="Memory in MiB (128-8192)", default=1024)
    for subparser, default in ((parser_prepare, "host"), (parser_update, "host"), (parser_run, "none")):
        subparser.add_argument("--network", choices=["host", "bridge", "none"], default=default,
                              help=f"Network mode (default: {default}); bridge requires the administrator setup in "
                                   "NETWORKING.md; host enables unrestricted QEMU user-mode NAT "
                                   "with access to host services, LAN and internet")
    parser_run.add_argument("--allow-sudo", action="store_true",
                            help="Allow passwordless sudo in the ephemeral guest")
    parser_run.add_argument("-w", "--workdir", metavar="DIR", help="Change to this directory inside the VM")
    parser_run.add_argument("--mount", type=Path, metavar="DIR", action="append", default=[],
                            help="Mount a directory in VM read-only, can be repeated")
    parser_run.add_argument("--mount-writable", type=Path, metavar="DIR", action="append", default=[],
                            help="Mount a host directory writable; host changes persist after exit, can be repeated")
    current_dir_mounts = parser_run.add_mutually_exclusive_group()
    current_dir_mounts.add_argument("--current-dir", action='store_true',
                                    help="Mount the current directory in VM read-only")
    current_dir_mounts.add_argument("--current-dir-writable", action='store_true',
                                    help="Mount the current host directory writable; host changes persist after exit")
    parser_run.add_argument("COMMAND", nargs=argparse.REMAINDER,
                            help="Command and arguments; virter options must precede the command")
    parser_run.set_defaults(func=run)

    for subparser in (parser_prepare, parser_update, parser_run):
        subparser.add_argument("--timeout", type=bounded_integer(1, 86400), default=3600, metavar="SECONDS",
                               help="Maximum runtime in seconds (1-86400, default: 3600)")

    args = parser.parse_args()
    if args.func:
        if args.func in (run, update):
            if args.COMMAND[:1] == ["--"]:
                args.COMMAND = args.COMMAND[1:]
            if args.COMMAND and not args.COMMAND[0]:
                parser.error("command name must not be empty")
        if args.func == update and args.sudo and not args.COMMAND:
            parser.error("update --sudo requires a command")
        if os.getuid() == 0 or os.geteuid() == 0:
            parser.error("virter must run as an unprivileged user; do not use sudo")
        if shutil.which("/usr/bin/bwrap") is None:
            parser.error("Bubblewrap (bwrap) is required for QEMU confinement")
        if not args._supervised:
            supervise(args)
            return
        with resource_limits(args):
            try:
                with tempfile.TemporaryDirectory() as directory:
                    temporary = Path(directory)
                    subprocess.run(qemu_confinement(temporary / "disk.img", temporary, NetworkMode.NONE, None)
                                   + ["/usr/bin/true"], check=True, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.PIPE, text=True)
            except (OSError, subprocess.CalledProcessError) as error:
                detail = error.stderr if isinstance(error, subprocess.CalledProcessError) else str(error)
                parser.error(f"QEMU confinement preflight failed: {detail}")
            args.func(args)
    else:
        parser.print_help()


def prepare(args):
    base_image = args.image
    if not base_image.is_file():
        sys.exit("Base image not found")
    base = args.base
    memory_mib = args.memory
    disk_mib = args.disk
    packages = args.packages
    prepare_or_update(base_image, base, memory_mib, disk_mib, packages, args.sha256, network=NetworkMode(args.network))


def update(args):
    base = args.base
    memory_mib = args.memory
    prepare_or_update(None, base, memory_mib, None, [],
                      command=args.COMMAND or None, sudo=args.sudo,
                      network=NetworkMode(args.network))


def prepare_or_update(base_image: Path | None, base: str, memory_mib: int, disk_mib: int | None,
                      packages: list[str], expected_sha256: str | None = None,
                      command: list[str] | None = None, sudo: bool = False,
                      network: NetworkMode = NetworkMode.HOST) -> None:
    cache_dir = prepare_cache_dir()
    with base_lock(cache_dir, base, exclusive=True):
        _prepare_or_update(cache_dir, base_image, base, memory_mib, disk_mib, packages,
                           expected_sha256, command, sudo, network)


def _prepare_or_update(cache_dir: Path, base_image: Path | None, base: str, memory_mib: int,
                       disk_mib: int | None, packages: list[str], expected_sha256: str | None,
                       command: list[str] | None, sudo: bool, network: NetworkMode):
    name = base
    vm_uuid = str(uuid.uuid4())

    base_path = base_image_path(cache_dir, base)

    if base_image:
        validate_disk_size(base_image)
        try:
            with base_image.open("rb") as source, os.fdopen(
                    os.open(base_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600),
                    "wb") as destination:
                try:
                    shutil.copyfileobj(source, destination)
                    destination.flush()
                    validate_import(base_path, expected_sha256)
                except BaseException:
                    base_path.unlink()
                    raise
        except FileExistsError:
            sys.exit(f"Base {base} already exists, choose another base name")
        subprocess.run([
            "/usr/bin/qemu-img",
            "resize",
            "-f", "qcow2",
            "-q",
            str(base_path),
            f"{disk_mib}M"
        ], check=True)
    else:
        if not base_path.is_file():
            sys.exit(f"Base {base} not found")
        validate_disk_size(base_path)

    temp_dir = Path(tempfile.mkdtemp(dir=runtime_directory()))
    try:
        if base_image:
            cloud_init_prepare(name, temp_dir, packages)
        else:
            cloud_init_update(name, temp_dir, command, sudo=sudo)

        run_vm(name, vm_uuid, base_path, temp_dir, memory_mib, network,
               base_image is not None, mounts=[], ephemeral=False)
    finally:
        if not isinstance(sys.exception(), ChildCleanupError):
            shutil.rmtree(temp_dir, ignore_errors=True)


def collect_mounts(args) -> list[tuple[Path, bool]]:
    requested = [(path, True) for path in args.mount] + [(path, False) for path in args.mount_writable]
    if args.current_dir or args.current_dir_writable:
        requested.append((Path("."), args.current_dir))

    home = Path.home().resolve()
    cache = cache_directory().resolve()
    runtime = runtime_directory().resolve()
    mounts = {}
    for path, readonly in requested:
        mount_dir = path.resolve()
        if not mount_dir.is_dir():
            sys.exit(f"Directory {mount_dir} not found")
        if home.is_relative_to(mount_dir):
            sys.exit(f"Refusing mount {mount_dir}: exposes the home directory")
        for protected, label in ((cache, "virter cache"), (runtime, "virter runtime directory")):
            if protected.is_relative_to(mount_dir) or mount_dir.is_relative_to(protected):
                sys.exit(f"Refusing mount {mount_dir}: exposes the {label}")
        if mount_dir in mounts:
            sys.exit(f"Directory {mount_dir} specified more than once")
        for other_dir, other_readonly in mounts.items():
            if readonly != other_readonly and (
                    mount_dir.is_relative_to(other_dir) or other_dir.is_relative_to(mount_dir)):
                sys.exit(f"Overlapping directories {mount_dir} and {other_dir} have conflicting mount permissions")
        mounts[mount_dir] = readonly

    # A parent must be mounted before its subdirectories, otherwise it would hide them
    return sorted(mounts.items(), key=lambda mount: len(mount[0].parts))


def run(args):
    cache_dir = prepare_cache_dir()
    with base_lock(cache_dir, args.base, exclusive=False):
        _run(args, cache_dir)


def _run(args, cache_dir: Path):
    name = args.name
    base = args.base
    memory_mib = args.memory
    network = NetworkMode(args.network)
    mounts = collect_mounts(args)

    vm_uuid = str(uuid.uuid4())

    base_path = base_image_path(cache_dir, base)

    if not base_path.is_file():
        sys.exit(f"Base {base} not found")
    validate_disk_size(base_path)

    temp_dir = Path(tempfile.mkdtemp(dir=runtime_directory()))
    disk_dir = None
    try:
        disk_dir = Path(tempfile.mkdtemp(dir=cache_dir))
        img_path = disk_dir / "disk.img"
        subprocess.run([
            "/usr/bin/qemu-img",
            "create",
            "-q",
            "-f",
            "qcow2",
            "-b",
            str(base_path),
            "-F",
            "qcow2",
            str(img_path),
        ], check=True)

        username = getpass.getuser()
        # Cloud-init logs bootcmd failures and continues; block autologin if privilege removal fails.
        restrict_user = (
            "if ! " + shlex.join(["usermod", "-G", "", "--", username])
            + " || ! rm -f /etc/sudoers.d/90-cloud-init-users; then "
            + "systemctl mask --runtime --now serial-getty@ttyS1.service; "
            + "/usr/sbin/poweroff -ff; exit 1; fi")
        privilege_commands = [] if args.allow_sudo else [["sh", "-c", restrict_user]]
        mount_commands = []
        for i, (mount_dir, mount_readonly) in enumerate(mounts):
            mount_commands.append(["mkdir", "-p", "--", str(mount_dir)])
            mount_commands.append(["mount", "-t", "virtiofs", *(["-o", "ro"] if mount_readonly else []),
                                   f"virtiofs{i}", str(mount_dir)])
        boot_commands = privilege_commands + mount_commands
        mount_data = "bootcmd:\n" + "".join(
            "- " + yaml_encode(command) + "\n" for command in boot_commands) if boot_commands else ""

        cols, rows = shutil.get_terminal_size()
        profile_lines = [f"stty cols {cols} rows {rows}"]
        if args.workdir:
            profile_lines.append(f"cd {shlex.quote(args.workdir)}")
        if args.COMMAND:
            profile_lines.append(shlex.join(args.COMMAND))
            # The image is discarded, so skip the slow orderly shutdown. Drain the serial output first, a
            # forced poweroff would otherwise cut it off. If the poweroff fails, logout shuts down normally.
            profile_lines.append('sync; stty "$(stty -g)"; sudo -n /usr/sbin/poweroff -ff >/dev/null 2>&1')
            profile_lines.append("logout")
        hushlogin_data = f"""- path: {yaml_encode(f"/home/{username}/.hushlogin")}
""" if args.workdir or args.COMMAND else ""
        profile = "\n".join(profile_lines) + "\n"
        poweroff_rule = f"#{os.getuid()} ALL=(root) NOPASSWD: /usr/sbin/poweroff -ff\n"
        sudo_data = "" if args.allow_sudo else f"""- path: /etc/sudoers.d/virter-poweroff
  permissions: '0440'
  content: {yaml_encode(poweroff_rule)}
"""
        command_data = f"""write_files:
{sudo_data}{hushlogin_data}- path: {yaml_encode(f"/home/{username}/.profile")}
  append: true
  content: {yaml_encode(profile)}
"""

        generate_cloud_init(
            name,
            temp_dir,
            vendor_data=CLOUD_CONFIG_HEADER + "users: []\n" + mount_data + command_data)

        run_vm(name, vm_uuid, img_path, temp_dir, memory_mib, network, is_prepare=False,
               mounts=mounts, ephemeral=True, backing_image=base_path)
    finally:
        if not isinstance(sys.exception(), ChildCleanupError):
            shutil.rmtree(temp_dir, ignore_errors=True)
            if disk_dir is not None:
                shutil.rmtree(disk_dir, ignore_errors=True)


def yaml_encode(value) -> str:
    # JSON quoting is YAML-compatible, except surrogate pairs and literal YAML line breaks.
    encoded = json.dumps(value, ensure_ascii=False)
    for character in (*map(chr, range(0x7f, 0xa0)), "\u2028", "\u2029", "\ufffe", "\uffff"):
        encoded = encoded.replace(character, f"\\u{ord(character):04x}")
    return encoded


def cloud_init_prepare(name: str, temp_dir: Path, packages: list[str]):
    username = getpass.getuser()
    cols, rows = shutil.get_terminal_size()
    getty_override = f"""[Service]
ExecStart=
ExecStart=-/usr/bin/login -p -f -- {username}
ExecStart=/sbin/shutdown -h --no-wall now
Type=oneshot
Restart=no
TTYColumns={cols}
TTYRows={rows}
"""
    generate_cloud_init(
        name,
        temp_dir,
        f"""{CLOUD_CONFIG_HEADER}user:
  name: {yaml_encode(username)}
  uid: {yaml_encode(str(os.getuid()))}
  groups: [adm, cdrom, dip, lxd, sudo]
  sudo: [\"ALL=(ALL) NOPASSWD:ALL\"]
  shell: /bin/bash
package_update: true
package_upgrade: true
packages: {yaml_encode(packages)}
write_files:
- path: /etc/systemd/system/serial-getty@.service.d/override.conf
  content: {yaml_encode(getty_override)}
- path: /etc/default/grub.d/50-cloudimg-settings.cfg
  content: |
    GRUB_RECORDFAIL_TIMEOUT=0
    GRUB_TIMEOUT=0
    GRUB_CMDLINE_LINUX_DEFAULT="quiet console=ttyS0 systemd.getty_auto=no"
    GRUB_TERMINAL=console      
runcmd:
- DEBIAN_FRONTEND=noninteractive apt-get purge -y openssh-server
- systemctl mask {" ".join(UNNEEDED_UNITS)}
- systemctl disable getty@tty1.service
- systemctl disable serial-getty@ttyS0.service
- systemctl enable serial-getty@ttyS1.service
- update-grub
power_state:
  delay: now
  mode: poweroff
  timeout: 10
  condition: true
""",
        generate_locales=True
    )


def cloud_init_update(name, temp_dir: Path, command: list[str] | None = None, sudo: bool = False):
    command_data = ""
    if command:
        username = "root" if sudo else getpass.getuser()
        cols, rows = shutil.get_terminal_size()
        script = f"stty cols {cols} rows {rows}\n" + shlex.join(command) + "\n"
        override = f"""[Service]
ExecStart=
ExecStart=-/usr/bin/sudo -i -u {username} -- /bin/bash /run/virter-command.sh
ExecStart=/sbin/shutdown -h --no-wall now
"""
        dropin = "/run/systemd/system/serial-getty@ttyS1.service.d"
        # bootcmd precedes write_files, so create the override before reloading systemd here.
        setup = (f"mkdir -p {dropin} && "
                 + shlex.join(["printf", "%s", script]) + " > /run/virter-command.sh && "
                 + shlex.join(["printf", "%s", override]) + f" > {dropin}/zz-command.conf && "
                 + "systemctl daemon-reload")
        command_data = "bootcmd:\n- " + yaml_encode(["sh", "-c", setup]) + "\n"
    generate_cloud_init(
        name,
        temp_dir,
        CLOUD_CONFIG_HEADER + "users: []\n" + command_data,
        generate_locales=True
    )


